{
  "name": "lefsim-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "build:wasm": "wasm-pack build crates/lefsim-wasm --target web --profile wasm-release --weak-refs --no-pack --out-dir ../../packages/lefsim/wasm && rm -f packages/lefsim/wasm/.gitignore",
    "test": "pnpm --filter lefsim test",
    "demo": "pnpm --filter demo dev",
    "typecheck": "pnpm -r typecheck",
    "docs:api": "typedoc --options packages/lefsim/typedoc.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~7.0",
    "wasm-pack": "^0.15.0"
  }
}
