// The browser demos as a static-assets-only Cloudflare Worker, deployed by
// .github/workflows/demo.yml at https://lefsim.abdenlab.org.
{
  "name": "lefsim-demo",
  "compatibility_date": "2026-10-01",
  // Vite's build output. replay.html is served at /replay, and /replay.html
  // redirects there (the default html_handling, "auto-trailing-slash").
  "assets": { "directory": "./dist" },
  // The custom domain: Cloudflare creates its DNS record and certificate on
  // the first deploy (which fails if a record for it already exists).
  "routes": [{ "pattern": "lefsim.abdenlab.org", "custom_domain": true }],
  // One canonical URL: no *.workers.dev address or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
}
