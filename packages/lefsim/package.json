    "fzstd": "^0.1.1",
    "hyparquet": "^1.31.2",
    "lefsim-wasm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
